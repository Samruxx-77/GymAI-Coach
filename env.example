# ─────────────────────────────────────────────────────────────
# GymAI Coach — environment variables
# Copy this file to `.env` (local) or add these in Vercel →
# Settings → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Supabase (database + auth) ────────────────────────────────
# Safe to expose: the anon key is a publishable client key —
# data access is protected by Row Level Security policies.
# Find both in Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# PRIVATE — server only (API routes). Never prefix with VITE_.
# Optional: only needed for privileged admin/server-side tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI provider (PRIVATE — server only, API routes) ──────────
# Primary provider: Google Gemini. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Fallback provider: OpenRouter (optional). If GEMINI_API_KEY is
# missing or the request fails, the server falls back to
# OpenRouter automatically.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── Vite dev server (local only — do NOT set in Vercel) ──────
# The Vite dev proxy forwards /api/* to this origin.
# In production on Vercel, /api/* are real serverless functions.
VITE_API_ORIGIN=http://localhost:8787
