# GymAI Coach — environment variables
# Copy to .env.local (Vite dev) and mirror in Vercel → Settings → Environment Variables.

# ── Required ──────────────────────────────────────────────────────────────
# Supabase project URL, e.g. https://xyzcompany.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (publishable) key — safe to expose in the browser bundle.
VITE_SUPABASE_ANON_KEY=

# OpenRouter key for AI coach + food scan (server-side only, never VITE_).
OPENROUTER_API_KEY=

# Supabase service-role key — REQUIRED for server routes that bypass RLS
# (account deletion, avatar cleanup, ai_usage ledger writes). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Gemini fallback when OpenRouter is down (server only).
GEMINI_API_KEY=

# Daily per-user AI quotas (defaults: coach 30, food scan 15).
AI_DAILY_COACH_LIMIT=30
AI_DAILY_FOOD_LIMIT=15

# Text/vision model chains (comma-separated fallback order).
AI_TEXT_MODELS=z-ai/glm-5.2:free,nex-agi/nex-n2.5-mini:free,qwen/qwen3.8-27b:free
AI_VISION_MODEL=inclusionai/ling-3.0-flash-vl:free

# OpenRouter referer headers (optional, for their rankings).
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=GymAI Coach

# ── Do NOT set ────────────────────────────────────────────────────────────
# VITE_API_ORIGIN — the client calls same-origin /api routes; setting this
# breaks production. Only used for local dev against server/dev-server.mjs.
